            "params": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/properties/params/additionalProperties/anyOf/0"
                    }
                  }
                ]
              },
              "description": "Params for every page, as in socialcrawl_request. No cursor."
            },
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "description": "Stop once this many unique rows are collected."
            },
            "max_credits": {
              "type": "integer",
              "minimum": 1,
              "description": "Spend cap: refused free when the quoted hold exceeds it (collect: the walk's budget)."
            },
            "format": {
              "type": "string",
              "enum": [
                "jsonl",
