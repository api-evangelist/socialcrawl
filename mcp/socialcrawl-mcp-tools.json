            },
            "method": {
              "type": "string",
              "enum": [
                "GET",
                "POST",
                "PATCH",
                "DELETE"
              ],
              "description": "Only for a resource served by several methods (prism/jobs). Inferred: a body selects POST."
            },
            "params": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/properties/params/additionalProperties/anyOf/0"
                    }
                  }
                ]
              },
              "description": "Query params, e.g. { handle: 'x', limit: 10 }. Arrays join with commas (label). Sent as strings."
            },
            "body": {
              "type": "object",
              "additionalProperties": {},
              "description": "JSON body for POST batch endpoints, e.g. { ids: [...] }."
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 16,
              "description": "Makes a retry safe: a replay returns the original response for 0 credits (24h)."
            },
            "fields": {
              "type": "string",
              "description": "Row paths exactly as socialcrawl_endpoint lists them, e.g. 'post.id,post.content.text,post.engagement.*' (or an array). Cuts tokens."
            },
            "max_items": {
              "type": "integer",
              "minimum": 1,
              "description": "Show at most this many rows; the full page stays behind the result link."
            },
            "format": {
