      {
        "name": "socialcrawl_request",
        "title": "Call an Endpoint",
        "description": "Call one endpoint (platform+resource, or id, or path). Validated locally first (a bad call is free), quoted, refused above max_credits and confirmed above the threshold. A large page is cut at row boundaries; socialcrawl_collect result_id reads the rest. Spends credits; needs SOCIALCRAWL_API_KEY.",
        "inputSchema": {
          "type": "object",
          "properties": {
